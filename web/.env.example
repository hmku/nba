# Public (safe to expose; RLS allows read-only SELECT for anon)
NEXT_PUBLIC_SUPABASE_URL=https://bdzpkdkhlzjzddkptjex.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_-v2T45D-2E361ksNm7OM1Q_BsgYRebd

# Server-only (set in Vercel project settings; never prefix with NEXT_PUBLIC_)
# Enables writes (manual draft picks, approval decisions). Without it the UI shows writes as disabled.
SUPABASE_SERVICE_ROLE_KEY=
# Passphrase required to unlock writes in the dashboard (stored as an httpOnly cookie session).
DASHBOARD_PASSPHRASE=
# Bearer token for the external-agent API (/api/agent/*, used by Meta Muse). Unset → those routes return 503.
AGENT_API_TOKEN=
# Web Push for new approvals (docs/runbooks/dashboard.md "Notifications"). Keys: `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://fantasy.harrisonku.com
# Bearer token the Supabase Database Webhook (approvals INSERT) sends to POST /api/push/notify. Unset → 503.
PUSH_NOTIFY_SECRET=
