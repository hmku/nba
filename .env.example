# Environment variables read by the Python package (names only; never commit values).
# The dashboard's variables are in web/.env.example.

# Database: unset -> local SQLite var/fantasy.db. Production: the Supabase Postgres pooler URL (secret, from the user).
FANTASY_DB_URL=
# Target of `fantasy publish` (Postgres URL) when --target is not given.
FANTASY_PUBLISH_URL=
# Postgres URL for the optional Postgres integration tests (tests skip when unset).
FANTASY_TEST_PG_URL=

# Agent operations: the current run (`export FANTASY_RUN_ID=$(fantasy run start ...)`) and draft (`--draft-id`).
FANTASY_RUN_ID=
FANTASY_DRAFT_ID=

# `fantasy publish --rest` (HTTPS to Supabase; in cloud sessions the key is injected by a network secret).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy name, used when SUPABASE_SECRET_KEY is unset.
SUPABASE_SERVICE_ROLE_KEY=

# Yahoo Fantasy API OAuth (Phase 2, league/yahoo_auth.py).
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=
YAHOO_OAUTH_FILE=
